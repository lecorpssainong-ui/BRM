{
  "name": "Product",
  "fields": {
    "name": { "type": "string", "required": true },
    "description": { "type": "string" },
    "price": { "type": "number", "required": true },
    "image_url": { "type": "string" },
    "category": { "type": "string" },
    "stock": { "type": "number", "default": 10 },
    "active": { "type": "boolean", "default": true }
  }
}
